+export const ExplorerDrawingIcon = () => (
+  <svg {...iconProps}>
+    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
+    <path d="M14 3v5h5" />
+  </svg>
+);
+
+export const ExplorerChevronIcon = () => (
+  <svg {...iconProps} width={12} height={12}>
+    <path d="M9 6l6 6-6 6" />
+  </svg>
+);
+
+export const ExplorerPlusIcon = () => (
+  <svg {...iconProps}>
+    <path d="M12 5v14M5 12h14" />
+  </svg>
+);
+
+export const ExplorerCloseIcon = () => (
+  <svg {...iconProps}>
+    <path d="M15 5l-7 7 7 7" />
+  </svg>
+);
+
+export const ExplorerMoreIcon = () => (
+  <svg {...iconProps} strokeWidth={2.25}>
+    <path d="M12 6h.01M12 12h.01M12 18h.01" />
+  </svg>
+);
