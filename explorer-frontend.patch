+import ConfirmDialog from "../../../packages/excalidraw/components/ConfirmDialog";
+
+type ExplorerDeleteConfirmDialogProps = {
+  itemKind: "project" | "file";
+  itemName: string;
+  onConfirm: () => void;
+  onCancel: () => void;
+};
+
+export const ExplorerDeleteConfirmDialog = ({
+  itemKind,
+  itemName,
+  onConfirm,
+  onCancel,
+}: ExplorerDeleteConfirmDialogProps) => {
+  const isProject = itemKind === "project";
+  const itemLabel = isProject ? "Projekt" : "Zeichnung";
+
+  return (
+    <ConfirmDialog
+      className="ExplorerDeleteConfirmDialog"
+      title={`${itemLabel} löschen`}
+      confirmText={`${itemLabel} löschen`}
+      cancelText="Abbrechen"
+      onConfirm={onConfirm}
+      onCancel={onCancel}
+    >
+      <p>
+        {itemLabel} „{itemName}“ wirklich löschen?
+      </p>
+      {isProject && (
+        <p className="ExplorerDeleteConfirmDialog__cascadeWarning">
+          Alle im Projekt enthaltenen Dateien werden ebenfalls gelöscht.
+        </p>
+      )}
+    </ConfirmDialog>
+  );
+};
