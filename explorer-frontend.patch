new file mode 100644
index 0000000..73e8ebc
--- /dev/null
+++ b/excalidraw-app/components/explorer/ExplorerNameDialog.tsx
@@ -0,0 +1,84 @@
+import { FormEvent, KeyboardEvent, useState } from "react";
+
+import { Dialog } from "../../../packages/excalidraw/components/Dialog";
+import DialogActionButton from "../../../packages/excalidraw/components/DialogActionButton";
+import { TextField } from "../../../packages/excalidraw/components/TextField";
+
+import "./ExplorerDialogs.scss";
+
+type ExplorerNameDialogProps = {
+  title: string;
+  label: string;
+  initialName?: string;
+  confirmText: string;
+  onConfirm: (name: string) => void;
+  onCancel: () => void;
+};
+
+const MAX_NAME_LENGTH = 200;
+
+export const ExplorerNameDialog = ({
+  title,
+  label,
+  initialName = "",
+  confirmText,
+  onConfirm,
+  onCancel,
+}: ExplorerNameDialogProps) => {
+  const [name, setName] = useState(initialName);
+  const normalizedName = name.trim();
+  const isValid =
+    normalizedName.length > 0 && normalizedName.length <= MAX_NAME_LENGTH;
+
+  const submitName = () => {
+    if (isValid) {
+      onConfirm(normalizedName);
+    }
+  };
+
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    submitName();
+  };
+
+  const handleInputKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === "Enter") {
+      event.preventDefault();
+      submitName();
+    }
+  };
+
+  return (
+    <Dialog
+      className="ExplorerNameDialog"
+      size="small"
+      title={title}
+      onCloseRequest={onCancel}
+    >
+      <form onSubmit={handleSubmit}>
+        <TextField
+          fullWidth
+          label={label}
+          value={name}
+          onChange={setName}
+          onKeyDown={handleInputKeyDown}
+          selectOnRender
+        />
+        <div className="ExplorerNameDialog__validation" aria-live="polite">
+          {normalizedName.length > MAX_NAME_LENGTH
+            ? `Maximal ${MAX_NAME_LENGTH} Zeichen erlaubt.`
+            : `${normalizedName.length}/${MAX_NAME_LENGTH}`}
+        </div>
+        <div className="ExplorerDialog__buttons">
+          <DialogActionButton label="Abbrechen" onClick={onCancel} />
+          <DialogActionButton
+            actionType="primary"
+            disabled={!isValid}
+            label={confirmText}
+            type="submit"
+          />
+        </div>
+      </form>
+    </Dialog>
+  );
+};
