+  onError,
+}: ExplorerOpenDialogProps) => {
+  const [projects, setProjects] = useState<ExplorerProject[]>([]);
+  const [filesByProject, setFilesByProject] = useState<
+    Record<string, ExplorerFileMeta[]>
+  >({});
+  const [expandedProjects, setExpandedProjects] = useState<Set<string>>(
+    () => new Set(activeProjectId ? [activeProjectId] : []),
+  );
+  const [loadingProjects, setLoadingProjects] = useState(true);
+  const [loadingFileProjects, setLoadingFileProjects] = useState<Set<string>>(
+    new Set(),
+  );
+  const [openingFileId, setOpeningFileId] = useState<string | null>(null);
+  const [isOpeningDeviceFile, setIsOpeningDeviceFile] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const reportError = useCallback(
+    (caught: unknown) => {
+      const message = getExplorerErrorMessage(caught);
+      setError(message);
+      onError(message);
+    },
+    [onError],
+  );
+
+  const loadFiles = useCallback(
+    async (projectId: string) => {
+      setLoadingFileProjects((current) => new Set(current).add(projectId));
+      try {
+        const files = await explorerApi.getFiles(projectId);
+        setFilesByProject((current) => ({
+          ...current,
+          [projectId]: sortByName(files),
+        }));
+      } catch (caught) {
+        reportError(caught);
+      } finally {
+        setLoadingFileProjects((current) => {
+          const next = new Set(current);
+          next.delete(projectId);
+          return next;
+        });
+      }
+    },
+    [reportError],
+  );
+
+  const loadProjects = useCallback(async () => {
+    setLoadingProjects(true);
+    setError(null);
+    try {
+      const loadedProjects = sortByName(await explorerApi.getProjects());
+      setProjects(loadedProjects);
+      if (
+        activeProjectId &&
+        loadedProjects.some((project) => project.id === activeProjectId)
+      ) {
+        await loadFiles(activeProjectId);
+      }
+    } catch (caught) {
+      reportError(caught);
+    } finally {
+      setLoadingProjects(false);
+    }
+  }, [activeProjectId, loadFiles, reportError]);
+
+  useEffect(() => {
+    void loadProjects();
+  }, [loadProjects]);
+
+  const toggleProject = (projectId: string) => {
+    const isExpanded = expandedProjects.has(projectId);
+    setExpandedProjects((current) => {
+      const next = new Set(current);
+      isExpanded ? next.delete(projectId) : next.add(projectId);
+      return next;
+    });
+    if (!isExpanded && !filesByProject[projectId]) {
+      void loadFiles(projectId);
+    }
+  };
+
+  const openExplorerFile = async (fileId: string) => {
+    if (openingFileId || isOpeningDeviceFile) {
+      return;
+    }
+    setOpeningFileId(fileId);
+    await onSelectFile(fileId);
+    onCloseRequest();
+  };
+
+  const openDeviceFile = async () => {
+    if (openingFileId || isOpeningDeviceFile) {
+      return;
+    }
+    setIsOpeningDeviceFile(true);
+    try {
+      const loaded = await loadFromJSON(
+        excalidrawAPI.getAppState(),
+        excalidrawAPI.getSceneElements(),
+      );
+      if (!(await onBeforeApplyDeviceScene())) {
+        return;
+      }
+      excalidrawAPI.updateScene({
+        elements: loaded.elements,
+        appState: loaded.appState,
+        commitToHistory: true,
+      });
+      excalidrawAPI.addFiles(Object.values(loaded.files || {}));
+    } catch (caught) {
+      if (
+        caught &&
+        typeof caught === "object" &&
+        "name" in caught &&
+        caught.name === "AbortError"
+      ) {
+        console.warn(caught);
+      } else {
+        const message =
+          caught instanceof Error
+            ? caught.message
+            : "Datei konnte nicht geöffnet werden.";
+        excalidrawAPI.updateScene({ appState: { errorMessage: message } });
+        onError(message);
+      }
+    } finally {
+      onCloseRequest();
+    }
+  };
+
+  return (
+    <Dialog
+      className="ExplorerOpenDialog"
+      size="small"
+      title="Zeichnung öffnen"
+      onCloseRequest={onCloseRequest}
+    >
+      <div className="ExplorerOpenDialog__tree">
+        {error && (
+          <div className="ExplorerOpenDialog__error">
+            <span>{error}</span>
+            <button type="button" onClick={() => void loadProjects()}>
+              Erneut versuchen
+            </button>
+          </div>
+        )}
+
+        {loadingProjects && projects.length === 0 ? (
+          <div className="ExplorerOpenDialog__message">
+            Projekte werden geladen…
+          </div>
+        ) : projects.length === 0 && !error ? (
+          <div className="ExplorerOpenDialog__message">
+            Noch keine Projekte vorhanden.
+          </div>
+        ) : (
+          projects.map((project) => {
+            const isExpanded = expandedProjects.has(project.id);
+            const files = filesByProject[project.id] || [];
+            return (
+              <section className="ExplorerOpenDialog__project" key={project.id}>
+                <button
+                  className="ExplorerOpenDialog__projectRow"
+                  type="button"
+                  aria-expanded={isExpanded}
+                  onClick={() => toggleProject(project.id)}
+                >
+                  <span className="ExplorerOpenDialog__chevron" aria-hidden>
+                    {isExpanded ? "▾" : "▸"}
+                  </span>
+                  <span aria-hidden>▰</span>
+                  <span className="ExplorerOpenDialog__name">
+                    {project.name}
+                  </span>
+                </button>
+
+                {isExpanded && (
+                  <div className="ExplorerOpenDialog__files">
+                    {loadingFileProjects.has(project.id) ? (
+                      <div className="ExplorerOpenDialog__message">
+                        Dateien werden geladen…
+                      </div>
+                    ) : files.length === 0 ? (
+                      <div className="ExplorerOpenDialog__message">
+                        Keine Zeichnungen in diesem Projekt.
+                      </div>
+                    ) : (
+                      files.map((file) => (
+                        <button
+                          className={clsx("ExplorerOpenDialog__fileRow", {
+                            active: file.id === activeFileId,
+                          })}
+                          type="button"
+                          key={file.id}
+                          aria-current={
+                            file.id === activeFileId ? "page" : undefined
+                          }
+                          disabled={Boolean(
+                            openingFileId || isOpeningDeviceFile,
+                          )}
+                          onClick={() => void openExplorerFile(file.id)}
+                        >
+                          <span aria-hidden>◇</span>
+                          <span className="ExplorerOpenDialog__name">
+                            {file.name}
+                          </span>
+                          {openingFileId === file.id && (
+                            <span className="ExplorerOpenDialog__opening">
+                              Öffnet…
+                            </span>
+                          )}
+                        </button>
+                      ))
+                    )}
+                  </div>
+                )}
+              </section>
+            );
+          })
+        )}
+      </div>
+
+      <div className="ExplorerDialog__buttons">
+        <DialogActionButton label="Abbrechen" onClick={onCloseRequest} />
+        <DialogActionButton
+          label="Von Gerät öffnen…"
+          disabled={Boolean(openingFileId || isOpeningDeviceFile)}
+          isLoading={isOpeningDeviceFile}
+          onClick={() => void openDeviceFile()}
+        />
+      </div>
+    </Dialog>
+  );
+};
