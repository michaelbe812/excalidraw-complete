@@ -0,0 +1,181 @@
+import { FormEvent, useCallback, useEffect, useState } from "react";
+
+import { Dialog } from "../../../packages/excalidraw/components/Dialog";
+import DialogActionButton from "../../../packages/excalidraw/components/DialogActionButton";
+import { TextField } from "../../../packages/excalidraw/components/TextField";
+import {
+  ExplorerProject,
+  explorerApi,
+  getExplorerErrorMessage,
+} from "../../data/explorer";
+
+import "./ExplorerDialogs.scss";
+
+export type ExplorerSaveToProjectOptions = {
+  fileName: string;
+  projectId: string | null;
+  newProjectName: string | null;
+};
+
+type ExplorerSaveToProjectDialogProps = {
+  initialFileName: string;
+  onSave: (options: ExplorerSaveToProjectOptions) => Promise<boolean>;
+  onCloseRequest: () => void;
+  onError: (message: string) => void;
+};
+
+const MAX_NAME_LENGTH = 200;
+const NEW_PROJECT_VALUE = "__new_project__";
+
+const sortByName = <T extends { name: string }>(items: T[]) =>
+  [...items].sort((a, b) => a.name.localeCompare(b.name));
+
+const isValidName = (name: string) => {
+  const normalizedName = name.trim();
+  return normalizedName.length > 0 && normalizedName.length <= MAX_NAME_LENGTH;
+};
+
+export const ExplorerSaveToProjectDialog = ({
+  initialFileName,
+  onSave,
+  onCloseRequest,
+  onError,
+}: ExplorerSaveToProjectDialogProps) => {
+  const [projects, setProjects] = useState<ExplorerProject[]>([]);
+  const [projectChoice, setProjectChoice] = useState("");
+  const [newProjectName, setNewProjectName] = useState("");
+  const [fileName, setFileName] = useState(initialFileName);
+  const [isLoading, setIsLoading] = useState(true);
+  const [isSaving, setIsSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const loadProjects = useCallback(async () => {
+    setIsLoading(true);
+    setError(null);
+    try {
+      const loadedProjects = sortByName(await explorerApi.getProjects());
+      setProjects(loadedProjects);
+      setProjectChoice(
+        (current) => current || loadedProjects[0]?.id || NEW_PROJECT_VALUE,
+      );
+    } catch (caught) {
+      const message = getExplorerErrorMessage(caught);
+      setError(message);
+      onError(message);
+    } finally {
+      setIsLoading(false);
+    }
+  }, [onError]);
+
+  useEffect(() => {
+    void loadProjects();
+  }, [loadProjects]);
+
+  const normalizedFileName = fileName.trim();
+  const normalizedProjectName = newProjectName.trim();
+  const isNewProject = projectChoice === NEW_PROJECT_VALUE;
+  const isValid =
+    isValidName(normalizedFileName) &&
+    (isNewProject
+      ? isValidName(normalizedProjectName)
+      : projects.some((project) => project.id === projectChoice));
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!isValid || isSaving) {
+      return;
+    }
+
+    setIsSaving(true);
+    const didSave = await onSave({
+      fileName: normalizedFileName,
+      projectId: isNewProject ? null : projectChoice,
+      newProjectName: isNewProject ? normalizedProjectName : null,
+    });
+    if (didSave) {
+      onCloseRequest();
+    } else {
+      setIsSaving(false);
+    }
+  };
+
+  return (
+    <Dialog
+      className="ExplorerSaveToProjectDialog"
+      size="small"
+      title="In Projekt speichern"
+      onCloseRequest={onCloseRequest}
+    >
+      <form onSubmit={(event) => void handleSubmit(event)}>
+        <label className="ExplorerSaveToProjectDialog__selectLabel">
+          <span>Projekt</span>
+          <select
+            value={projectChoice}
+            disabled={isLoading || isSaving}
+            onChange={(event) => setProjectChoice(event.target.value)}
+          >
+            {isLoading && <option value="">Projekte werden geladen…</option>}
+            {projects.map((project) => (
+              <option key={project.id} value={project.id}>
+                {project.name}
+              </option>
+            ))}
+            <option value={NEW_PROJECT_VALUE}>Neues Projekt…</option>
+          </select>
+        </label>
+
+        {isNewProject && (
+          <TextField
+            fullWidth
+            label="Name des neuen Projekts"
+            value={newProjectName}
+            onChange={setNewProjectName}
+            selectOnRender
+          />
+        )}
+
+        <TextField
+          fullWidth
+          label="Dateiname"
+          value={fileName}
+          onChange={setFileName}
+          selectOnRender={!isNewProject}
+        />
+
+        <div
+          className="ExplorerSaveToProjectDialog__validation"
+          aria-live="polite"
+        >
+          {normalizedFileName.length > MAX_NAME_LENGTH ||
+          (isNewProject && normalizedProjectName.length > MAX_NAME_LENGTH)
+            ? `Maximal ${MAX_NAME_LENGTH} Zeichen erlaubt.`
+            : `${normalizedFileName.length}/${MAX_NAME_LENGTH}`}
+        </div>
+
+        {error && (
+          <div className="ExplorerSaveToProjectDialog__error">
+            <span>{error}</span>
+            <button type="button" onClick={() => void loadProjects()}>
+              Erneut versuchen
+            </button>
+          </div>
+        )}
+
+        <div className="ExplorerDialog__buttons">
+          <DialogActionButton
+            label="Abbrechen"
+            disabled={isSaving}
+            onClick={onCloseRequest}
+          />
+          <DialogActionButton
+            actionType="primary"
+            disabled={!isValid || isLoading || isSaving}
+            isLoading={isSaving}
+            label={isSaving ? "Speichert…" : "Speichern"}
+            type="submit"
+          />
+        </div>
+      </form>
+    </Dialog>
+  );
+};
