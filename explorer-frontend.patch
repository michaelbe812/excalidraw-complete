+        const restored = restore(explorerFile.data, currentAppState, null, {
+          repairBindings: true,
+        });
+
+        suppressExplorerChangeRef.current = true;
+        setActiveExplorerFile(explorerFile.meta);
+        explorerSceneRef.current = explorerFile.data;
+        explorerDirtyRef.current = false;
+        setExplorerSaveStatus("saved");
+
+        excalidrawAPI.resetScene({ resetLoadingState: true });
+        excalidrawAPI.updateScene({
+          elements: restored.elements,
+          appState: {
+            ...restored.appState,
+            theme: currentAppState.theme,
+            isLoading: false,
+          },
+          commitToHistory: true,
+        });
+        excalidrawAPI.addFiles(Object.values(restored.files));
+        excalidrawAPI.history.clear();
+
+        window.requestAnimationFrame(() => {
+          suppressExplorerChangeRef.current = false;
+        });
+      } catch (caught) {
+        suppressExplorerChangeRef.current = false;
+        showExplorerError(
+          `Zeichnung konnte nicht geöffnet werden: ${getExplorerErrorMessage(
+            caught,
+          )}`,
+        );
+      }
+    },
