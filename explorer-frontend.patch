+
+type ContextMenuState =
+  | { kind: "project"; project: ExplorerProject; x: number; y: number }
+  | { kind: "file"; file: ExplorerFileMeta; x: number; y: number };
+
+type ExplorerPanelProps = {
+  activeFileId: string | null;
+  activeProjectId: string | null;
+  isCollaborating: boolean;
+  saveStatus: ExplorerSaveStatus;
+  onOpenFile: (fileId: string) => Promise<void>;
+  onActiveFileDeleted: () => void;
+  onActiveFileMetaChange: (file: ExplorerFileMeta) => void;
+  onError: (message: string) => void;
+};
+
+const sortByName = <T extends { name: string }>(items: T[]) =>
+  [...items].sort((a, b) => a.name.localeCompare(b.name));
+
+const getPromptName = (label: string, currentName = "") => {
+  const value = window.prompt(label, currentName);
+  return value?.trim() || null;
+};
+
+export const ExplorerPanel = ({
+  activeFileId,
+  activeProjectId,
+  isCollaborating,
+  saveStatus,
+  onOpenFile,
+  onActiveFileDeleted,
+  onActiveFileMetaChange,
+  onError,
+}: ExplorerPanelProps) => {
+  const [isOpen, setIsOpen] = useState(
+    () => localStorage.getItem(EXPLORER_PANEL_OPEN_KEY) === "true",
+  );
+  const [projects, setProjects] = useState<ExplorerProject[]>([]);
+  const [filesByProject, setFilesByProject] = useState<
+    Record<string, ExplorerFileMeta[]>
+  >({});
+  const [expandedProjects, setExpandedProjects] = useState<Set<string>>(
+    new Set(),
+  );
+  const [loadingProjects, setLoadingProjects] = useState(false);
+  const [hasLoadedProjects, setHasLoadedProjects] = useState(false);
+  const [loadingFileProjects, setLoadingFileProjects] = useState<Set<string>>(
+    new Set(),
+  );
+  const [error, setError] = useState<string | null>(null);
+  const [contextMenu, setContextMenu] = useState<ContextMenuState | null>(null);
+
+  const reportError = useCallback(
+    (caught: unknown) => {
+      const message = getExplorerErrorMessage(caught);
+      setError(message);
+      onError(message);
+    },
+    [onError],
+  );
+
+  const loadProjects = useCallback(async () => {
+    setLoadingProjects(true);
+    setError(null);
+    try {
+      setProjects(await explorerApi.getProjects());
+      setHasLoadedProjects(true);
+    } catch (caught) {
+      reportError(caught);
+    } finally {
+      setLoadingProjects(false);
+    }
+  }, [reportError]);
+
+  const loadFiles = useCallback(
+    async (projectId: string) => {
+      setLoadingFileProjects((current) => new Set(current).add(projectId));
+      try {
+        const files = await explorerApi.getFiles(projectId);
+        setFilesByProject((current) => ({ ...current, [projectId]: files }));
+      } catch (caught) {
+        reportError(caught);
+      } finally {
+        setLoadingFileProjects((current) => {
+          const next = new Set(current);
+          next.delete(projectId);
+          return next;
+        });
+      }
+    },
+    [reportError],
+  );
+
+  useEffect(() => {
+    localStorage.setItem(EXPLORER_PANEL_OPEN_KEY, String(isOpen));
+    if (isOpen && !loadingProjects && !hasLoadedProjects && !error) {
+      void loadProjects();
+    }
+  }, [error, hasLoadedProjects, isOpen, loadProjects, loadingProjects]);
+
+  useEffect(() => {
+    if (!contextMenu) {
+      return;
+    }
+    const close = () => setContextMenu(null);
+    const closeOnEscape = (event: KeyboardEvent) => {
+      if (event.key === "Escape") {
+        close();
+      }
+    };
+    window.addEventListener("pointerdown", close);
+    window.addEventListener("keydown", closeOnEscape);
+    return () => {
+      window.removeEventListener("pointerdown", close);
+      window.removeEventListener("keydown", closeOnEscape);
+    };
+  }, [contextMenu]);
+
+  const createProject = async () => {
+    setContextMenu(null);
+    const name = getPromptName("Name des neuen Projekts");
+    if (!name) {
+      return;
+    }
+    try {
+      const project = await explorerApi.createProject(name);
+      setProjects((current) => sortByName([...current, project]));
+      setFilesByProject((current) => ({ ...current, [project.id]: [] }));
+      setExpandedProjects((current) => new Set(current).add(project.id));
+      setError(null);
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const renameProject = async (project: ExplorerProject) => {
+    setContextMenu(null);
+    const name = getPromptName("Projekt umbenennen", project.name);
+    if (!name || name === project.name) {
+      return;
+    }
+    try {
+      const updated = await explorerApi.renameProject(project.id, name);
+      setProjects((current) =>
+        sortByName(
+          current.map((item) => (item.id === updated.id ? updated : item)),
+        ),
+      );
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const deleteProject = async (project: ExplorerProject) => {
+    setContextMenu(null);
+    if (
+      !window.confirm(
+        `Projekt „${project.name}“ wirklich löschen? Alle enthaltenen Dateien werden ebenfalls gelöscht.`,
+      )
+    ) {
+      return;
+    }
+    try {
+      await explorerApi.deleteProject(project.id);
+      setProjects((current) =>
+        current.filter((item) => item.id !== project.id),
+      );
+      setFilesByProject((current) => {
+        const next = { ...current };
+        delete next[project.id];
+        return next;
+      });
+      if (activeProjectId === project.id) {
+        onActiveFileDeleted();
+      }
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const createFile = async (project: ExplorerProject) => {
+    setContextMenu(null);
+    const name = getPromptName("Name der neuen Zeichnung");
+    if (!name) {
+      return;
+    }
+    try {
+      const file = await explorerApi.createFile(project.id, name);
+      setFilesByProject((current) => ({
+        ...current,
+        [project.id]: sortByName([...(current[project.id] || []), file]),
+      }));
+      setExpandedProjects((current) => new Set(current).add(project.id));
+      await onOpenFile(file.id);
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const renameFile = async (file: ExplorerFileMeta) => {
+    setContextMenu(null);
+    const name = getPromptName("Zeichnung umbenennen", file.name);
+    if (!name || name === file.name) {
+      return;
+    }
+    try {
+      const updated = await explorerApi.updateFile(file.id, { name });
+      setFilesByProject((current) => ({
+        ...current,
+        [file.projectId]: sortByName(
+          (current[file.projectId] || []).map((item) =>
+            item.id === updated.id ? updated : item,
+          ),
+        ),
+      }));
+      if (activeFileId === file.id) {
+        onActiveFileMetaChange(updated);
+      }
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const deleteFile = async (file: ExplorerFileMeta) => {
+    setContextMenu(null);
+    if (!window.confirm(`Zeichnung „${file.name}“ wirklich löschen?`)) {
+      return;
+    }
+    try {
+      await explorerApi.deleteFile(file.id);
+      setFilesByProject((current) => ({
+        ...current,
+        [file.projectId]: (current[file.projectId] || []).filter(
+          (item) => item.id !== file.id,
+        ),
+      }));
+      if (activeFileId === file.id) {
+        onActiveFileDeleted();
+      }
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const moveFile = async (file: ExplorerFileMeta, projectId: string) => {
+    setContextMenu(null);
+    try {
+      const updated = await explorerApi.updateFile(file.id, { projectId });
+      setFilesByProject((current) => ({
+        ...current,
+        [file.projectId]: (current[file.projectId] || []).filter(
+          (item) => item.id !== file.id,
+        ),
+      }));
+      setExpandedProjects((current) => new Set(current).add(projectId));
+      await loadFiles(projectId);
+      if (activeFileId === file.id) {
+        onActiveFileMetaChange(updated);
+      }
+    } catch (caught) {
+      reportError(caught);
+    }
+  };
+
+  const toggleProject = (projectId: string) => {
+    const isExpanded = expandedProjects.has(projectId);
+    setExpandedProjects((current) => {
+      const next = new Set(current);
+      isExpanded ? next.delete(projectId) : next.add(projectId);
+      return next;
+    });
+    if (!isExpanded && !filesByProject[projectId]) {
+      void loadFiles(projectId);
+    }
+  };
+
+  const openContextMenu = (
+    event: React.MouseEvent,
+    target:
+      | { kind: "project"; project: ExplorerProject }
+      | { kind: "file"; file: ExplorerFileMeta },
+  ) => {
+    event.preventDefault();
+    event.stopPropagation();
+    setContextMenu({ ...target, x: event.clientX, y: event.clientY });
+  };
+
+  const saveLabel = isCollaborating
+    ? "Autosave während Zusammenarbeit deaktiviert"
+    : saveStatus === "saving"
+    ? "Speichert…"
+    : saveStatus === "pending"
+    ? "Änderungen ausstehend"
+    : saveStatus === "error"
+    ? "Speichern fehlgeschlagen"
+    : saveStatus === "saved"
+    ? "Gespeichert"
+    : "Keine Datei geöffnet";
+
+  return (
+    <>
+      {!isOpen && (
+        <button
+          className="ExplorerToggle"
+          type="button"
+          title="Files öffnen"
+          aria-label="Files öffnen"
+          onClick={() => setIsOpen(true)}
+        >
+          <span aria-hidden="true">☰</span>
+          <span>Files</span>
+        </button>
+      )}
+
+      {isOpen && (
+        <aside className="ExplorerPanel" aria-label="Files Explorer">
+          <header className="ExplorerPanel__header">
+            <div>
+              <h2>Files</h2>
+              <div className="ExplorerPanel__saveStatus" role="status">
+                <span
+                  className={clsx("ExplorerPanel__statusDot", {
+                    "is-saving": saveStatus === "saving",
+                    "is-error": saveStatus === "error",
+                    "is-disabled": isCollaborating,
+                  })}
+                />
+                {saveLabel}
+              </div>
+            </div>
+            <div className="ExplorerPanel__headerActions">
+              <button
+                type="button"
+                title="Neues Projekt"
+                onClick={createProject}
+              >
+                +
+              </button>
+              <button
+                type="button"
+                title="Files schließen"
+                aria-label="Files schließen"
+                onClick={() => setIsOpen(false)}
+              >
+                ×
+              </button>
+            </div>
+          </header>
+
+          {error && (
+            <div className="ExplorerPanel__error">
+              <span>{error}</span>
+              <button type="button" onClick={loadProjects}>
+                Erneut versuchen
+              </button>
+            </div>
+          )}
+
+          <div className="ExplorerPanel__tree">
+            {loadingProjects && projects.length === 0 ? (
+              <div className="ExplorerPanel__message">
+                Projekte werden geladen…
+              </div>
+            ) : projects.length === 0 && !error ? (
+              <div className="ExplorerPanel__empty">
+                <p>
+                  Noch keine Projekte. Lege ein Projekt für deine Zeichnungen
+                  an.
+                </p>
+                <button type="button" onClick={createProject}>
+                  Neues Projekt
+                </button>
+              </div>
+            ) : (
+              projects.map((project) => {
+                const isExpanded = expandedProjects.has(project.id);
+                const files = filesByProject[project.id] || [];
+                return (
+                  <section className="ExplorerPanel__project" key={project.id}>
+                    <div
+                      className="ExplorerPanel__row ExplorerPanel__projectRow"
+                      onContextMenu={(event) =>
+                        openContextMenu(event, { kind: "project", project })
+                      }
+                    >
+                      <button
+                        className="ExplorerPanel__rowMain"
+                        type="button"
+                        aria-expanded={isExpanded}
+                        onClick={() => toggleProject(project.id)}
+                      >
+                        <span
+                          className="ExplorerPanel__chevron"
+                          aria-hidden="true"
+                        >
+                          {isExpanded ? "▾" : "▸"}
+                        </span>
+                        <span aria-hidden="true">▰</span>
+                        <span className="ExplorerPanel__name">
+                          {project.name}
+                        </span>
+                      </button>
+                      <button
+                        className="ExplorerPanel__more"
+                        type="button"
+                        aria-label={`Aktionen für ${project.name}`}
+                        onClick={(event) =>
+                          openContextMenu(event, { kind: "project", project })
+                        }
+                      >
+                        ⋮
+                      </button>
+                    </div>
+
+                    {isExpanded && (
+                      <div className="ExplorerPanel__files">
+                        {loadingFileProjects.has(project.id) ? (
+                          <div className="ExplorerPanel__message">
+                            Dateien werden geladen…
+                          </div>
+                        ) : files.length === 0 ? (
+                          <button
+                            className="ExplorerPanel__newFile"
+                            type="button"
+                            onClick={() => createFile(project)}
+                          >
+                            + Neue Zeichnung
+                          </button>
+                        ) : (
+                          <>
+                            {files.map((file) => (
+                              <div
+                                className={clsx(
+                                  "ExplorerPanel__row",
+                                  "ExplorerPanel__fileRow",
+                                  { active: file.id === activeFileId },
+                                )}
+                                key={file.id}
+                                onContextMenu={(event) =>
+                                  openContextMenu(event, { kind: "file", file })
+                                }
+                              >
+                                <button
+                                  className="ExplorerPanel__rowMain"
+                                  type="button"
+                                  onClick={() => void onOpenFile(file.id)}
+                                >
+                                  <span aria-hidden="true">◇</span>
+                                  <span className="ExplorerPanel__name">
+                                    {file.name}
+                                  </span>
+                                </button>
+                                <button
+                                  className="ExplorerPanel__more"
+                                  type="button"
+                                  aria-label={`Aktionen für ${file.name}`}
+                                  onClick={(event) =>
+                                    openContextMenu(event, {
+                                      kind: "file",
+                                      file,
+                                    })
+                                  }
+                                >
+                                  ⋮
+                                </button>
+                              </div>
+                            ))}
+                            <button
+                              className="ExplorerPanel__newFile"
+                              type="button"
+                              onClick={() => createFile(project)}
+                            >
+                              + Neue Zeichnung
+                            </button>
+                          </>
+                        )}
+                      </div>
+                    )}
+                  </section>
+                );
+              })
+            )}
+          </div>
+        </aside>
+      )}
+
+      {contextMenu && (
+        <div
+          className="ExplorerContextMenu"
+          role="menu"
+          style={{ left: contextMenu.x, top: contextMenu.y }}
+          onPointerDown={(event) => event.stopPropagation()}
+        >
+          {contextMenu.kind === "project" ? (
+            <>
+              <button
+                type="button"
+                role="menuitem"
+                onClick={() => createFile(contextMenu.project)}
+              >
+                Neue Zeichnung
+              </button>
+              <button
+                type="button"
+                role="menuitem"
+                onClick={() => renameProject(contextMenu.project)}
+              >
+                Umbenennen
+              </button>
+              <button
+                className="danger"
+                type="button"
+                role="menuitem"
+                onClick={() => deleteProject(contextMenu.project)}
+              >
+                Löschen
+              </button>
+            </>
+          ) : (
+            <>
+              <button
+                type="button"
+                role="menuitem"
+                onClick={() => renameFile(contextMenu.file)}
+              >
+                Umbenennen
+              </button>
+              {projects.length > 1 && (
+                <div className="ExplorerContextMenu__move">
+                  <span>Verschieben nach</span>
+                  {projects
+                    .filter(
+                      (project) => project.id !== contextMenu.file.projectId,
+                    )
+                    .map((project) => (
+                      <button
+                        type="button"
+                        role="menuitem"
+                        key={project.id}
+                        onClick={() => moveFile(contextMenu.file, project.id)}
+                      >
+                        {project.name}
+                      </button>
+                    ))}
+                </div>
+              )}
+              <button
+                className="danger"
+                type="button"
+                role="menuitem"
+                onClick={() => deleteFile(contextMenu.file)}
+              >
+                Löschen
+              </button>
+            </>
+          )}
+        </div>
+      )}
+    </>
+  );
+};
