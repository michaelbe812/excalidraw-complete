+              <button
+                className="danger"
+                type="button"
+                role="menuitem"
+                onClick={() => deleteFile(contextMenu.file)}
+              >
+                Löschen
+              </button>
+            </>
+          )}
+        </div>
+      )}
+    </>
+  );
