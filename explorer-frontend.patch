+import type { ExcalidrawElement } from "../../packages/excalidraw/element/types";
+import type { ImportedDataState } from "../../packages/excalidraw/data/types";
+import type { AppState, BinaryFiles } from "../../packages/excalidraw/types";
+import { serializeAsJSON } from "../../packages/excalidraw/data/json";
+
+export const EXPLORER_CURRENT_FILE_KEY = "explorer:currentFileId";
+export const EXPLORER_PANEL_OPEN_KEY = "explorer:panelOpen";
+
+export type ExplorerProject = {
+  id: string;
+  name: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type ExplorerFileMeta = {
+  id: string;
+  projectId: string;
+  name: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type ExplorerScene = {
+  type: "excalidraw";
+  version: 2;
+  elements: readonly ExcalidrawElement[];
+  appState: NonNullable<ImportedDataState["appState"]>;
+  files: BinaryFiles;
+};
+
+export type ExplorerFile = {
+  meta: ExplorerFileMeta;
+  data: ExplorerScene;
+};
+
+export class ExplorerApiError extends Error {
+  public readonly status: number;
+
+  constructor(message: string, status: number) {
+    super(message);
+    this.name = "ExplorerApiError";
+    this.status = status;
+  }
+}
+
+const getErrorMessage = (value: unknown) => {
+  if (
+    value &&
+    typeof value === "object" &&
+    "error" in value &&
+    typeof value.error === "string"
+  ) {
+    return value.error;
+  }
+  return null;
+};
+
+const request = async <T>(path: string, init?: RequestInit): Promise<T> => {
+  const response = await fetch(path, {
+    ...init,
+    headers: init?.body
+      ? { "Content-Type": "application/json", ...init.headers }
+      : init?.headers,
+  });
+
+  if (!response.ok) {
+    let message = `Explorer-Anfrage fehlgeschlagen (${response.status})`;
+    try {
+      message = getErrorMessage(await response.json()) || message;
+    } catch {
+      // The backend may be unavailable or return a non-JSON proxy response.
+    }
+    throw new ExplorerApiError(message, response.status);
+  }
+
+  if (response.status === 204) {
+    return undefined as T;
+  }
+  return response.json() as Promise<T>;
+};
+
+const projectPath = (projectId: string) =>
+  `/api/explorer/projects/${encodeURIComponent(projectId)}`;
+const filePath = (fileId: string) =>
+  `/api/explorer/files/${encodeURIComponent(fileId)}`;
+
+export const explorerApi = {
+  async getProjects() {
+    return (
+      await request<{ projects: ExplorerProject[] }>("/api/explorer/projects")
+    ).projects;
+  },
+
+  createProject(name: string) {
+    return request<ExplorerProject>("/api/explorer/projects", {
+      method: "POST",
+      body: JSON.stringify({ name }),
+    });
+  },
+
+  renameProject(projectId: string, name: string) {
+    return request<ExplorerProject>(projectPath(projectId), {
+      method: "PATCH",
+      body: JSON.stringify({ name }),
+    });
+  },
+
+  deleteProject(projectId: string) {
+    return request<void>(projectPath(projectId), { method: "DELETE" });
+  },
+
+  async getFiles(projectId: string) {
+    return (
+      await request<{ files: ExplorerFileMeta[] }>(
+        `${projectPath(projectId)}/files`,
+      )
+    ).files;
+  },
+
+  createFile(projectId: string, name: string, data?: ExplorerScene) {
+    return request<ExplorerFileMeta>(`${projectPath(projectId)}/files`, {
+      method: "POST",
+      body: JSON.stringify({ name, ...(data ? { data } : {}) }),
+    });
+  },
+
+  getFile(fileId: string) {
+    return request<ExplorerFile>(filePath(fileId));
+  },
+
+  updateFile(
+    fileId: string,
+    changes: {
+      name?: string;
+      projectId?: string;
+      data?: ExplorerScene;
+    },
+  ) {
+    return request<ExplorerFileMeta>(filePath(fileId), {
+      method: "PUT",
+      body: JSON.stringify(changes),
+    });
+  },
+
+  deleteFile(fileId: string) {
+    return request<void>(filePath(fileId), { method: "DELETE" });
+  },
+};
+
+export const createExplorerScene = (
+  elements: readonly ExcalidrawElement[],
+  appState: AppState,
+  files: BinaryFiles,
+): ExplorerScene => {
+  const serialized = JSON.parse(
+    serializeAsJSON(elements, appState, files, "local"),
+  ) as ImportedDataState;
+
+  return {
+    type: "excalidraw",
+    version: 2,
+    elements: serialized.elements || [],
+    appState: serialized.appState || {},
+    files: serialized.files || {},
+  };
+};
+
+export const getExplorerErrorMessage = (error: unknown) =>
+  error instanceof Error ? error.message : "Unbekannter Explorer-Fehler";
