 export const EXPLORER_CURRENT_FILE_KEY = "explorer:currentFileId";
 export const EXPLORER_PANEL_OPEN_KEY = "explorer:panelOpen";
+export const EXPLORER_PANEL_WIDTH_KEY = "explorer:panelWidth";
+
+export const EXPLORER_PANEL_DEFAULT_WIDTH = 280;
+export const EXPLORER_PANEL_MIN_WIDTH = 200;
+export const EXPLORER_PANEL_MAX_WIDTH = 520;
+
+// Unterhalb dieser Breite (Excalidraws MQ_MAX_WIDTH_PORTRAIT) überlagert die
+// Sidebar den Canvas, statt ihn zu verschmälern — sonst bliebe zu wenig
+// Zeichenfläche übrig.
+export const EXPLORER_PANEL_OVERLAY_BREAKPOINT = 730;
+
+export const clampExplorerPanelWidth = (width: number) =>
+  Math.min(
+    EXPLORER_PANEL_MAX_WIDTH,
+    Math.max(EXPLORER_PANEL_MIN_WIDTH, Math.round(width)),
+  );
+
+/** Sidebar ist standardmäßig sichtbar; nur eine explizite Wahl blendet sie aus. */
+export const readExplorerPanelOpen = () =>
+  localStorage.getItem(EXPLORER_PANEL_OPEN_KEY) !== "false";
+
+export const readExplorerPanelWidth = () => {
+  const stored = Number(localStorage.getItem(EXPLORER_PANEL_WIDTH_KEY));
+  return Number.isFinite(stored) && stored > 0
+    ? clampExplorerPanelWidth(stored)
+    : EXPLORER_PANEL_DEFAULT_WIDTH;
+};
 
