+
+const getPromptName = (label: string, currentName = "") => {
+  const value = window.prompt(label, currentName);
+  return value?.trim() || null;
+};
+
+export const ExplorerPanel = ({
+  activeFileId,
+  activeProjectId,
+  isCollaborating,
+  saveStatus,
+  onOpenFile,
+  onActiveFileDeleted,
+  onActiveFileMetaChange,
+  onError,
+}: ExplorerPanelProps) => {
+  const [isOpen, setIsOpen] = useState(
+    () => localStorage.getItem(EXPLORER_PANEL_OPEN_KEY) === "true",
+  );
+  const [projects, setProjects] = useState<ExplorerProject[]>([]);
+  const [filesByProject, setFilesByProject] = useState<
+    Record<string, ExplorerFileMeta[]>
